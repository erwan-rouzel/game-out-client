<mxfile host="app.diagrams.net"><diagram name="GpsToPaddle" id="GpsToPaddle"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cal" value="Calibration (Cal button)" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#f3ecf7;strokeColor=#9673a6;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="300" as="geometry"/></mxCell><mxCell id="bl" value="1. stand on the back-left corner&#10;press Cal (BL)" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="56" as="geometry"/></mxCell><mxCell id="br" value="2. walk to the back-right corner&#10;distance shown, OK beyond 45 m&#10;press Cal (BR): game starts" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="70" as="geometry"/></mxCell><mxCell id="st" value="RemoteGameState created:&#10;session opened on the server" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="56" as="geometry"/></mxCell><mxCell id="g1" value="" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#7d8590;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#eef0f2;" edge="1" parent="1" source="bl" target="br"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="" style="html=0;fontFamily=Helvetica;fontSize=12;