<mxfile host="app.diagrams.net"><diagram name="ClientServer" id="ClientServer"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cc" value="Android app (game-out-client)" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#eef5fd;strokeColor=#6c8ebf;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="440" height="560" as="geometry"/></mxCell><mxCell id="gps" value="GameActivity: Fused Location Provider&#10;GPS fix every 800 ms, field calibrated on 2 corners" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="400" height="56" as="geometry"/></mxCell><mxCell id="conv" value="LatiLongHV, PlayFieldPos&#10;GPS fix -&gt; paddle position on a 12000 x 12000 field,&#10;extrapolated between fixes" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="70" as="geometry"/></mxCell><mxCell id="thr" value="PlayFieldThread: every 125 ms&#10;syncGameState(), then draw ball and paddles" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="254" width="400" height="56" as="geometry"/></mxCell><mxCell id="net" value="RemoteGameState, GameoutClient&#10;start the session (TCP), then send the paddle&#10;position and read the game state (UDP)" style="html=0;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;rounded=1;arcSize=10;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometr